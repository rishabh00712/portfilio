<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Cool Hover Effect</title>
    <style>
        * {
            margin: 0;
            padding: 0;
            box-sizing: border-box;
        }
        body {
            display: flex;
            justify-content: center;
            align-items: center;
            height: 100vh;
            background-color: #69a16e99;
        }
        .container {
            position: relative;
            width: 1200px;
            height: 600px;
            overflow: hidden;
            border-radius: 10px;
            box-shadow: 0 25px 25px rgba(45, 43, 43, 0.508);
        }
        .container img {
            width: 100%;
            height: 100%;
            display: block;
            transition: transform 0.3s ease-in-out;
        }
        .container:hover img {
            transform: scale(1.1);
        }
        .overlay {
            position: absolute;
            bottom: 10px;
            left: 50%;
            transform: translateX(-10%);
            width: 100%;
            text-align: center;
            font-size: 18px;
            font-weight: bold;
            color: rgb(28, 27, 27);
            opacity: 0;
            transition: opacity 0.3s ease-in-out, transform 0.3s ease-in-out;
            box-shadow: 0 65px 65px rgba(45, 43, 43, 0.508);
            text-shadow: 0 65px 65px rgba(45, 43, 43, 0.508);
        }
        .container:hover .overlay {
            opacity: 1;
            transform: translate(-50%, -50%);
            bottom: 0%;
        }
        .overlay {
        color: white; /* Adjust color as needed */
        font-size: 20px;
        font-weight: bold;
        text-shadow: 2px 2px 5px rgba(0, 0, 0, 0.5), 
         0 0 10px rgba(0, 255, 255, 0.7), 
         0 0 20px rgba(0, 255, 255, 0.5);

        }
        
        @media screen and (max-width: 980px){
            .container {
            position: relative;
            width: 1200px;
            height: 400px;
            overflow: hidden;
            border-radius: 10px;
            box-shadow: 0 25px 25px rgba(45, 43, 43, 0.508);
            }   
            .overlay {
            opacity: 1;
            position: absolute;
            left: 10%;
            top: 20px;
            }
        }
    </style>
</head>
<body>
    <div class="container" onclick="location.href='/exp'">
        <img src="/intern 1stop.jpg" alt="Internship">
        <p class="overlay">CLICK FOR BACK</p>
    </div>
</body>

<script>
    document.addEventListener("DOMContentLoaded", function () {
       const sound = new Audio("/folder_open.mp3");
       sound.play();
       
    })
</script>

</html>