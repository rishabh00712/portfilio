<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Page Turnover Effect</title>
    <link rel="stylesheet" href="styles.css">
</head>
<style>
    /* Basic reset */
* {
    margin: 0;
    padding: 0;
    box-sizing: border-box;
}

body {
    display: flex;
    justify-content: center;
    align-items: center;
    height: 100vh;
    background-color: #f0f0f0;
    font-family: Arial, sans-serif;
}

/* Book container */
.book {
    perspective: 1000px;
    width: 300px;
    height: 400px;
    position: relative;
}

/* Page styling */
.page {
    width: 100%;
    height: 100%;
    position: absolute;
    transform-style: preserve-3d;
    transform-origin: left;
    transition: transform 1.5s ease-in-out;
}

/* Front and back sides of the page */
.front, .back {
    position: absolute;
    width: 100%;
    height: 100%;
    backface-visibility: hidden;
    display: flex;
    flex-direction: column;
    justify-content: center;
    align-items: center;
    padding: 20px;
    box-shadow: 0 0 10px rgba(0, 0, 0, 0.3);
}

.front {
    background-color: #fff;
}

.back {
    background-color: #e0e0e0;
    transform: rotateY(180deg);
}

/* Hover effect to trigger the page turn */
.book:hover .page {
    transform: rotateY(-180deg);
}
</style>
<body>
    <div class="book">
        <div class="page">
            <div class="front">
                <h1>Front Page</h1>
                <p>This is the front side of the page.</p>
            </div>
            <div class="back">
                <h1>Back Page</h1>
                <p>This is the back side of the page.</p>
            </div>
        </div>
    </div>
</body>
</html>
<script>
    document.getElementById('turnPage').addEventListener('click', () => {
    const page = document.querySelector('.page');
    page.style.transform = 'rotateY(-180deg)';
});
</script>