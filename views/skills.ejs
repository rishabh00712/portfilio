            </div>
          </div>
        <script>
            document.addEventListener("DOMContentLoaded", function () {
                let options = {
                    root: null, // viewport
                    rootMargin: "0px",
                    threshold: 0.5, // Trigger when 10% of the element is visible
                };

                let observer = new IntersectionObserver((entries, observer) => {
                    entries.forEach(entry => {
                        if (entry.isIntersecting) {
                            let block = entry.target;
                            block.classList.add("loaded"); // Show the block (by adding a loaded class)
                            // Set background image
                            observer.unobserve(block); // Stop observing once loaded
                        }
                    });
                }, options);

                // Observe all lazy-load blocks
                document.querySelectorAll(".lazy-load").forEach(block => {
                    observer.observe(block);
                });
            });
            window.addEventListener('load', function () {
                const sound = new Audio("/page_sound.mp3"); // Ensure correct path to sound
                sound.play();
                // Hide the loading screen after the page is fully loaded
                setTimeout(function () {
                    document.getElementById('loading-screen').style.display = 'none';
                    document.getElementById('content').style.display = 'block';
                }, 500); // Adjust the time as needed (in ms)
            });
        </script>
